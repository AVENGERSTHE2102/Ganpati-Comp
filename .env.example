# ─── MongoDB Atlas Configuration ─────────────────────────────────────────────
# Connection string from MongoDB Atlas cluster:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=marathi_club

# ─── Google OAuth 2.0 (Google Cloud Console) ──────────────────────────────────
# 1. Visit https://console.cloud.google.com/apis/credentials
# 2. Create an "OAuth 2.0 Client ID" with type "Web Application"
# 3. Add Authorized redirect URIs:
#    - Development: http://localhost:3000/api/auth/google/callback
#    - Production:  https://your-domain.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── App URL ──────────────────────────────────────────────────────────────────
# Base URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Session Secret ───────────────────────────────────────────────────────────
# Random 32+ character secret for JWT session encryption
SESSION_SECRET=change-me-to-a-random-32-char-secret-key-12345678

# ─── Vercel Blob Storage ─────────────────────────────────────────────────────
# Token provided by Vercel when connecting a Blob store to your project
# Can be retrieved from Vercel Dashboard -> Storage -> Your Blob Store
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Admin Users (Optional) ──────────────────────────────────────────────────
# Comma-separated list of additional admin Google account emails
ADMIN_EMAILS=
