# Copy this file to .env and fill in real values. Never commit .env to git.

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────
# Connection string from your MongoDB Atlas cluster:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=marathi_club

# ─── Google OAuth 2.0 (Google Cloud Console) ────────────────────────────────
# 1. Visit https://console.cloud.google.com/apis/credentials
# 2. Create an "OAuth 2.0 Client ID" with type "Web Application"
# 3. Add Authorized redirect URIs (NextAuth's fixed callback path):
#    - Development: http://localhost:3000/api/auth/callback/google
#    - Production:  https://your-domain.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ─── App URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Session Secret ────────────────────────────────────────────────────────
# Random 32+ character secret used to sign NextAuth sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-32-char-secret-key

# ─── Vercel Blob Storage ─────────────────────────────────────────────────────
# Token from Vercel Dashboard -> Storage -> Your Blob Store
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# ─── Admin Users ────────────────────────────────────────────────────────────
# Comma-separated Google account emails allowed into /admin
ADMIN_EMAILS=sabnisa7@gmail.com
